format_time() {
  local hours=$1
  local mins=$2

  if [ "$hours" -ge 24 ]; then
    local days=$(( hours / 24 ))
    local rem_hours=$(( hours % 24 ))
    if [ "$rem_hours" -gt 0 ]; then
      printf "%dd %dh %dm" "$days" "$rem_hours" "$mins"
    else
      printf "%dd %dm" "$days" "$mins"
    fi
  else
    printf "%dh %dm" "$hours" "$mins"
  fi
}

get_color_code() {
  local pct=$1
  local color_code="\033[38;5;46m"  # Green
  if [ "$pct" -le 16 ]; then
    color_code="\033[38;5;88m"      # Super Dark Red
  elif [ "$pct" -le 33 ]; then
    color_code="\033[1;31m"         # Red
  elif [ "$pct" -le 49 ]; then
    color_code="\033[38;5;208m"     # Orange
  elif [ "$pct" -le 66 ]; then
    color_code="\033[1;33m"         # Yellow
  elif [ "$pct" -le 83 ]; then
    color_code="\033[38;5;118m"     # Chartreuse
  fi
  printf "%s" "$color_code"
}

render_bar() {
  local pct=$1
  local width=32
  local filled=$(( pct * width / 100 ))
  [ $filled -gt $width ] && filled=$width
  local empty=$(( width - filled ))

  local filled_bar=""
  local empty_bar=""
  local i

  for ((i=0; i<filled; i++)); do filled_bar="${filled_bar}█"; done
  for ((i=0; i<empty; i++)); do empty_bar="${empty_bar}░"; done

  local color_code="$(get_color_code "$pct")"
  printf "  [%b%s\033[90m%s\033[0m]" "$color_code" "$filled_bar" "$empty_bar"
}

fetch_profile_quota() {
  local target_prof="${1-}"

  local dirs=()
  if [ -n "$target_prof" ]; then
    validate_name "$target_prof"
    local ppath="$(profile_dir "$target_prof")"
    [ -d "$ppath" ] || abort "profile '$target_prof' does not exist"
    dirs=("$ppath")
  else
    if [ ! -d "$BASE" ]; then
      print_info "No profiles found."
      return 0
    fi
    for d in "$BASE"/*; do
      [ -d "$d" ] || continue
      [ "$(basename "$d")" = ".templates" ] && continue
      dirs+=("$d")
    done
  fi

  local first=true
  for d in "${dirs[@]}"; do
    local name="$(basename "$d")"

    if [ "$first" = false ]; then
      echo ""
      echo -e "\033[90m────────────────────────────────────────────────────────────────────────────────\033[0m"
    fi
    first=false

    echo ""
    echo -e "\033[1;36m└ Models & Quota (\033[1;33m$name\033[1;36m)\033[0m"
    
    local account="unknown"
    local config_file="$d/.gemini/config/config.json"
    if [ -f "$config_file" ]; then
      local parsed_acc=$(grep -o '"email"[^,]*' "$config_file" 2>/dev/null | cut -d'"' -f4 || true)
      [ -n "$parsed_acc" ] && account="$parsed_acc"
    fi
    if [ "$account" = "unknown" ]; then
      local log_file
      log_file=$(ls -1t "$d"/.gemini/antigravity-cli/log/cli-*.log 2>/dev/null | head -n 1 || true)
      if [ -f "$log_file" ]; then
        local log_acc=$(grep -o 'authenticated successfully as [^ ]*' "$log_file" 2>/dev/null | head -n 1 | awk '{print $4}' || true)
        [ -n "$log_acc" ] && account="$log_acc"
      fi
    fi
    if [ "$account" = "unknown" ]; then
      local sys_config="$HOME/.gemini/config/config.json"
      if [ -f "$sys_config" ]; then
        local parsed_acc=$(grep -o '"email"[^,]*' "$sys_config" 2>/dev/null | cut -d'"' -f4 || true)
        [ -n "$parsed_acc" ] && account="$parsed_acc"
      fi
    fi
    if [ "$account" = "unknown" ]; then
      local sys_log
      sys_log=$(ls -1t "$HOME"/.gemini/antigravity-cli/log/cli-*.log 2>/dev/null | head -n 1 || true)
      if [ -f "$sys_log" ]; then
        local sys_acc=$(grep -o 'authenticated successfully as [^ ]*' "$sys_log" 2>/dev/null | head -n 1 | awk '{print $4}' || true)
        [ -n "$sys_acc" ] && account="$sys_acc"
      fi
    fi

    echo -e "  \033[90mAccount:\033[0m \033[1;37m$account\033[0m"
    echo ""

    # Live API Quota Fetch
    local token_file="$d/.gemini/antigravity-cli/antigravity-oauth-token"
    [ ! -f "$token_file" ] && token_file="$HOME/.gemini/antigravity-cli/antigravity-oauth-token"

    local access_token=""
    local refresh_token=""
    if [ -f "$token_file" ]; then
      access_token=$(grep -o '"access_token"[^,]*' "$token_file" 2>/dev/null | cut -d'"' -f4 || true)
      refresh_token=$(grep -o '"refresh_token"[^,]*' "$token_file" 2>/dev/null | cut -d'"' -f4 || true)
    fi

    local live_json=""
    if [ -n "$access_token" ]; then
      live_json=$(curl -s -X POST -H "Authorization: Bearer $access_token" -H "User-Agent: AntigravityCLI" -H "Content-Type: application/json" -d '{}' "https://daily-cloudcode-pa.googleapis.com/v1internal:fetchAvailableModels" 2>/dev/null || true)
    fi

    # Automatic OAuth Token Refresh if token expired or 401 unauthenticated
    if echo "$live_json" | grep -q "UNAUTHENTICATED" && [ -n "$refresh_token" ]; then
      local client_id="1071006060591-tmhssin2h21lcre235vtolojh4g403ep.apps.googleusercontent.com"
      local client_secret="GOCSPX-q_429a3473"
      local refresh_resp
      refresh_resp=$(curl -s -X POST "https://oauth2.googleapis.com/token" \
        --data-urlencode "client_id=$client_id" \
        --data-urlencode "client_secret=$client_secret" \
        --data-urlencode "grant_type=refresh_token" \
        --data-urlencode "refresh_token=$refresh_token" 2>/dev/null || true)

      local new_acc_token
      new_acc_token=$(echo "$refresh_resp" | grep -o '"access_token"[^,]*' | cut -d'"' -f4 || true)
      if [ -n "$new_acc_token" ]; then
        access_token="$new_acc_token"
        sed -i "s/\"access_token\":\"[^\"]*\"/\"access_token\":\"$new_acc_token\"/" "$token_file" 2>/dev/null || true
        live_json=$(curl -s -X POST -H "Authorization: Bearer $access_token" -H "User-Agent: AntigravityCLI" -H "Content-Type: application/json" -d '{}' "https://daily-cloudcode-pa.googleapis.com/v1internal:fetchAvailableModels" 2>/dev/null || true)
      fi
    fi

    if [ -z "$live_json" ] || echo "$live_json" | grep -q "UNAUTHENTICATED"; then
      echo -e "  \033[1;31mFailed to fetch live quota (Session expired or unauthenticated)\033[0m"
      echo -e "  \033[90mRun 'mgy $name' to refresh login credentials.\033[0m"
      echo ""
      continue
    fi

    # Gemini Group Quota (from gemini-3.6-flash-high)
    local gemini_frac=$(echo "$live_json" | grep -A 10 '"gemini-3.6-flash-high"' | grep '"remainingFraction"' | head -n 1 | awk '{print $2}' | tr -d ',' || true)
    
    # Claude Group Quota (from claude-sonnet-4-6)
    local claude_frac=$(echo "$live_json" | grep -A 10 '"claude-sonnet-4-6"' | grep '"remainingFraction"' | head -n 1 | awk '{print $2}' | tr -d ',' || true)

    echo -e "\033[1;35mGEMINI MODELS\033[0m"
    echo -e "  \033[90mModels within this group:\033[0m \033[36mGemini Flash\033[0m, \033[36mGemini Pro\033[0m"
    echo ""
    if [ -n "$gemini_frac" ]; then
      local gemini_pct=$(awk "BEGIN {printf \"%.2f\", $gemini_frac * 100}")
      local gemini_int=$(awk "BEGIN {printf \"%d\", $gemini_frac * 100}")
      local gemini_color="$(get_color_code "$gemini_int")"
      local gemini_reset=$(echo "$live_json" | grep -A 10 '"gemini-3.6-flash-high"' | grep '"resetTime"' | head -n 1 | cut -d'"' -f4 || true)
      local gemini_time_str="Quota available"
      if [ -n "$gemini_reset" ]; then
        local now_sec=$(date +%s)
        local reset_sec=$(date -d "$gemini_reset" +%s 2>/dev/null || date -j -f "%Y-%m-%dT%H:%M:%SZ" "$gemini_reset" +%s 2>/dev/null || echo 0)
        if [ "$reset_sec" -gt "$now_sec" ]; then
          local diff_sec=$(( reset_sec - now_sec ))
          local diff_h=$(( diff_sec / 3600 ))
          local diff_m=$(( (diff_sec % 3600) / 60 ))
          gemini_time_str="Refreshes in $(format_time $diff_h $diff_m)"
        fi
      fi

      echo -e "  \033[1mWeekly Limit Remaining\033[0m"
      render_bar "$gemini_int"
      echo -e " ${gemini_color}${gemini_pct}%\033[0m"
      echo -e "  \033[90m${gemini_int}% remaining · ${gemini_time_str}\033[0m"
    else
      echo -e "  \033[90mQuota information unavailable\033[0m"
    fi
    echo ""

    echo -e "\033[1;35mCLAUDE AND GPT MODELS\033[0m"
    echo -e "  \033[90mModels within this group:\033[0m \033[36mClaude Opus\033[0m, \033[36mClaude Sonnet\033[0m, \033[36mGPT-4o\033[0m"
    echo ""
    if [ -n "$claude_frac" ]; then
      local claude_pct=$(awk "BEGIN {printf \"%.2f\", $claude_frac * 100}")
      local claude_int=$(awk "BEGIN {printf \"%d\", $claude_frac * 100}")
      local claude_color="$(get_color_code "$claude_int")"
      local claude_reset=$(echo "$live_json" | grep -A 10 '"claude-sonnet-4-6"' | grep '"resetTime"' | head -n 1 | cut -d'"' -f4 || true)
      local claude_time_str="Quota available"
      if [ -n "$claude_reset" ]; then
        local now_sec=$(date +%s)
        local reset_sec=$(date -d "$claude_reset" +%s 2>/dev/null || date -j -f "%Y-%m-%dT%H:%M:%SZ" "$claude_reset" +%s 2>/dev/null || echo 0)
        if [ "$reset_sec" -gt "$now_sec" ]; then
          local diff_sec=$(( reset_sec - now_sec ))
          local diff_h=$(( diff_sec / 3600 ))
          local diff_m=$(( (diff_sec % 3600) / 60 ))
          claude_time_str="Refreshes in $(format_time $diff_h $diff_m)"
        fi
      fi

      echo -e "  \033[1mWeekly Limit Remaining\033[0m"
      render_bar "$claude_int"
      echo -e " ${claude_color}${claude_pct}%\033[0m"
      echo -e "  \033[90m${claude_int}% remaining · ${claude_time_str}\033[0m"
    else
      echo -e "  \033[90mQuota information unavailable\033[0m"
    fi
    echo ""
  done
}

case "$cmd" in
  new)
    shift
    new_profile "$@"
    ;;
  list)
    list_profiles "${2-}"
    ;;
  status)
    status_profiles
    ;;
  quota | q)
    fetch_profile_quota "${2-}"
    ;;
  rename)
    rename_profile "${2-}" "${3-}"
    ;;
  delete)
    delete_profile "${2-}"
    ;;
  clone)
    clone_profile "${2-}" "${3-}"
    ;;
  template)
    shift
    template_cmd "$@"
    ;;
  export)
    export_profile "${2-}" "${3-}"
    ;;
  import)
    import_profile "${2-}" "${3-}"
    ;;
  sync)
    shift
    sync_profile "$@"
    ;;
  update)
    update_cli
    ;;
  doctor)
    doctor_cli
    ;;
  stats)
    profile_stats
    ;;
  completion)
    if [ "${2-}" = "install" ]; then
      install_completion
    elif [ -n "${2-}" ]; then
      generate_completion "$2"
    else
      help_completion
    fi
    ;;
  help | --help | -h)
    usage
    ;;
  "")
    usage
    exit 1
    ;;
  *)
    launch_profile "$cmd" "${@:2}"
    ;;
esac
