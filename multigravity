            COMPREPLY=( $(compgen -W "${profiles}" -- "${cur}") )
            return 0
            ;;
    esac
}
complete -F _multigravity_completions multigravity mgy
EOF
      ;;
  esac
}



usage() {
  local cols
  cols=$(tput cols 2>/dev/null || true)
  if [ -z "$cols" ] || [ "$cols" -le 0 ] 2>/dev/null; then
    cols=$(stty size 2>/dev/null | awk '{print $2}' || true)
  fi
  cols="${cols:-${COLUMNS:-80}}"

  if is_termux || [ "$cols" -lt 75 ]; then
    cat <<EOF
Usage: mgy <command> [args]

Commands:
  new [name] [options]
    Create a new profile (runs interactive wizard if name omitted)
    --shared: Share settings & extensions
    --from <tpl>: Seed from a template

  list
    List existing profiles

  status
    Show state, type & storage size

  quota [name]
    Show quota & remaining limits per account/profile

  rename <old> <new>
