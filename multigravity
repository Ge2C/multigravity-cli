#!/data/data/com.termux/files/usr/bin/env bash
set -euo pipefail

shopt -s nullglob

BASE="${MULTIGRAVITY_HOME:-$HOME/AntigravityProfiles}"
cmd="${1-}"

abort() {
  echo "Error: $1" >&2
  exit 1
}

print_info() {
  echo "$1"
}

# Cached platform result — set on first call to avoid repeated uname forks.
_PLATFORM=""

platform() {
  if [ -n "$_PLATFORM" ]; then
    printf '%s\n' "$_PLATFORM"
    return 0
  fi

  local raw
  raw="${MULTIGRAVITY_PLATFORM-}"
  [ -z "$raw" ] && raw="$(uname -s)"
  raw="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"

  case "$raw" in
    darwin | macos | mac | osx) _PLATFORM="darwin" ;;
    linux)                       _PLATFORM="linux"  ;;
    *)
      abort "unsupported platform '$raw'. Multigravity supports macOS and Linux."
      ;;
  esac
  printf '%s\n' "$_PLATFORM"
}

is_termux() {
  [ -n "${TERMUX_VERSION-}" ] || [ -d "/data/data/com.termux" ]
}

profile_dir() {
  printf '%s/%s\n' "$BASE" "$1"
}

templates_dir() {
  printf '%s/.templates\n' "$BASE"
}

is_shared_profile() {
  [ -f "$(profile_dir "$1")/.shared" ]
}

user_data_dir() {
  local profile_path=$1

  case "$(platform)" in
    darwin)
      printf '%s/Library/Application Support/Antigravity\n' "$profile_path"
      ;;
    linux)
      printf '%s/.config/Antigravity\n' "$profile_path"
      ;;
  esac
}

extensions_dir() {
  local profile_path=$1
  printf '%s/.antigravity/extensions\n' "$profile_path"
}

system_user_data_dir() {
  if [ -d "$HOME/.gemini/antigravity-cli" ]; then
    printf '%s/.gemini/antigravity-cli\n' "$HOME"
    return 0
  fi
  case "$(platform)" in
    darwin) printf '%s/Library/Application Support/Antigravity\n' "$HOME" ;;
    linux)  printf '%s/.config/Antigravity\n' "$HOME" ;;
  esac
}

system_extensions_dir() {
  printf '%s/.antigravity/extensions\n' "$HOME"
}

linux_launcher_dir() {
  printf '%s/.local/share/multigravity/launchers\n' "$HOME"
}

linux_launcher_path() {
  printf '%s/%s.sh\n' "$(linux_launcher_dir)" "$1"
}

linux_desktop_path() {
  printf '%s/.local/share/applications/multigravity-%s.desktop\n' "$HOME" "$1"
}

mac_shortcut_path() {
  printf '%s/Applications/Multigravity %s.app\n' "$HOME" "$1"
}

validate_name() {
  local name=$1

  if [[ -z "$name" ]]; then
    abort "profile name required"
  fi

  if ! [[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*$ ]]; then
    abort "profile name must start with alphanumeric and contain only letters, numbers, or hyphens"
  fi
}

command_or_path() {
  local candidate=$1

  if [ -z "$candidate" ]; then
    return 1
  fi

  if [ -d "$candidate" ] || [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  if command -v "$candidate" >/dev/null 2>&1; then
    command -v "$candidate"
    return 0
  fi

  return 1
}

find_app() {
  local override candidate resolved

  override="${MULTIGRAVITY_APP-}"
  if [ -n "$override" ]; then
    resolved="$(command_or_path "$override" 2>/dev/null)" && printf '%s\n' "$resolved" && return 0
  fi

  case "$(platform)" in
    darwin)
      for candidate in \
        "/Applications/Antigravity.app" \
        "$HOME/Applications/Antigravity.app"
      do
        if [ -d "$candidate" ]; then
          printf '%s\n' "$candidate"
          return 0
        fi
      done
      ;;
    linux)
      for candidate in \
        "antigravity" \
        "agy" \
        "${PREFIX:-}/bin/antigravity" \
        "${PREFIX:-}/bin/agy" \
        "/usr/share/antigravity/antigravity" \
        "/usr/bin/antigravity" \
        "/usr/local/bin/antigravity" \
        "$HOME/.local/bin/antigravity" \
        "$HOME/.local/bin/agy" \
        "$HOME/Applications/Antigravity.AppImage"
      do
        resolved="$(command_or_path "$candidate" 2>/dev/null)" && printf '%s\n' "$resolved" && return 0
      done
      ;;
  esac

  return 1
}

require_app() {
  local app

  if ! app="$(find_app)"; then
    case "$(platform)" in
      darwin)
        abort "Antigravity.app was not found. Install Antigravity or set MULTIGRAVITY_APP to the app bundle path."
        ;;
      linux)
        abort "Antigravity was not found. Install the Linux app so 'antigravity' is on PATH, or set MULTIGRAVITY_APP to the executable path."
        ;;
    esac
  fi

  printf '%s\n' "$app"
}

_mk_linux_profile_dirs() {
  # Creates the standard Linux XDG directory tree inside a profile directory.
  local profile_path=$1
  mkdir -p \
    "$profile_path/.gemini/antigravity-cli" \
    "$profile_path/.config/Antigravity" \
    "$profile_path/.cache" \
    "$profile_path/.local/share" \
    "$profile_path/.local/state"
}

create_profile_layout() {
  local profile_path=$1

  mkdir -p "$profile_path"
  mkdir -p "$(extensions_dir "$profile_path")"

  case "$(platform)" in
    darwin)
      mkdir -p "$profile_path/Library/Application Support"

      if [ ! -e "$profile_path/Library/Keychains" ] && [ -d "$HOME/Library/Keychains" ]; then
        ln -s "$HOME/Library/Keychains" "$profile_path/Library/Keychains"
      fi
      ;;
    linux)
      _mk_linux_profile_dirs "$profile_path"
      ;;
  esac
}

create_shared_layout() {
  local profile_path=$1
  local sys_data sys_ext data_dir ext_dir

  sys_data="$(system_user_data_dir)"
  sys_ext="$(system_extensions_dir)"

  mkdir -p "$profile_path"
  touch "$profile_path/.shared"

  # Isolated user-data dir so accounts stay separate
  data_dir="$(user_data_dir "$profile_path")"
  mkdir -p "$data_dir/User"

  # Point settings/keybindings/snippets at the system install (read-only intent)
  if [ -d "$sys_data/User" ]; then
    local f
    for f in settings.json keybindings.json snippets; do
      if [ -e "$sys_data/User/$f" ] && [ ! -e "$data_dir/User/$f" ]; then
        ln -s "$sys_data/User/$f" "$data_dir/User/$f"
      fi
    done
  fi

  # Share the system extensions directory rather than an empty copy
  ext_dir="$(extensions_dir "$profile_path")"
  mkdir -p "$(dirname "$ext_dir")"
  if [ -d "$sys_ext" ]; then
    rm -rf "$ext_dir"
    ln -s "$sys_ext" "$ext_dir"
  else
    mkdir -p "$ext_dir"
  fi

  # Share Antigravity CLI plugins, skills & config
  if [ -d "$HOME/.gemini/config" ]; then
    mkdir -p "$profile_path/.gemini/config"
    local item
    for item in plugins mcp_config.json config.json; do
      if [ -e "$HOME/.gemini/config/$item" ]; then
        if [ ! -L "$profile_path/.gemini/config/$item" ]; then
          rm -rf "$profile_path/.gemini/config/$item"
          ln -s "$HOME/.gemini/config/$item" "$profile_path/.gemini/config/$item"
        fi
      fi
    done
  fi

  # Auto-share global NPM cache to reduce profile storage size
  if [ -d "$HOME/.npm" ]; then
    if [ -e "$profile_path/.npm" ] && [ ! -L "$profile_path/.npm" ]; then
      if [ -d "$profile_path/.npm" ]; then
        cp -rn "$profile_path/.npm"/* "$HOME/.npm/" 2>/dev/null || true
      fi
      rm -rf "$profile_path/.npm"
    fi
    if [ ! -L "$profile_path/.npm" ]; then
      rm -rf "$profile_path/.npm"
      ln -s "$HOME/.npm" "$profile_path/.npm"
    fi
  fi

  # Auto-share conversations index so sessions can be seamlessly resumed across profiles
  local target_conv="$profile_path/.gemini/antigravity-cli/conversations"
  local sys_conv="$HOME/.gemini/antigravity-cli/conversations"
  if [ -d "$sys_conv" ]; then
    mkdir -p "$(dirname "$target_conv")"
    if [ -d "$target_conv" ] && [ ! -L "$target_conv" ]; then
      cp -rn "$target_conv"/* "$sys_conv/" 2>/dev/null || true
      rm -rf "$target_conv"
    fi
    if [ ! -e "$target_conv" ]; then
      ln -s "$sys_conv" "$target_conv"
    fi
  fi

  # Auto-share brain/ conversation history safely (migrating existing history first)
  local target_brain="$profile_path/.gemini/antigravity-cli/brain"
  local sys_brain="$HOME/.gemini/antigravity-cli/brain"
  if [ "${SHARE_HISTORY:-true}" = "true" ] && [ -d "$sys_brain" ]; then
    mkdir -p "$(dirname "$target_brain")"
    if [ -d "$target_brain" ] && [ ! -L "$target_brain" ]; then
      # Safely copy existing profile history into system brain to prevent data loss
      cp -rn "$target_brain"/* "$sys_brain/" 2>/dev/null || true
      rm -rf "$target_brain"
    fi
    if [ ! -e "$target_brain" ]; then
      ln -s "$sys_brain" "$target_brain"
    fi
  fi

  case "$(platform)" in
    darwin)
      mkdir -p "$profile_path/Library/Application Support"
      if [ ! -e "$profile_path/Library/Keychains" ] && [ -d "$HOME/Library/Keychains" ]; then
        ln -s "$HOME/Library/Keychains" "$profile_path/Library/Keychains"
      fi
      ;;
    linux)
      _mk_linux_profile_dirs "$profile_path"
      ;;
  esac
}

script_path() {
  local installed dir

  # Prefer the canonical name; fall back to the mgy alias (Termux installs as mgy only)
  installed="$(command -v multigravity 2>/dev/null || command -v mgy 2>/dev/null || true)"
  if [ -n "$installed" ]; then
    printf '%s\n' "$installed"
    return 0
  fi

  dir="$(cd "$(dirname "$0")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$0")"
}

shell_quote() {
  printf '%q' "$1"
}

desktop_quote() {
  local value=$1

  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//\$/\\$}
  value=${value//\`/\\\`}
  printf '"%s"' "$value"
}

create_shortcut_darwin() {
  local profile=$1
  local app_name="Multigravity $profile"
  local app_dir
  local run_script
  local launcher
  local icon_src

  app_dir="$(mac_shortcut_path "$profile")"
  run_script="$app_dir/Contents/MacOS/run"
  launcher="$(script_path)"
  icon_src="$(dirname "$launcher")/icon.icns"

  mkdir -p "$app_dir/Contents/MacOS"
  mkdir -p "$app_dir/Contents/Resources"

  cat <<EOF > "$run_script"
#!/usr/bin/env bash
export MULTIGRAVITY_HOME=$(shell_quote "$BASE")
exec $(shell_quote "$launcher") $(shell_quote "$profile") "\$@"
EOF

  chmod +x "$run_script"

  if [ -f "$icon_src" ]; then
    cp "$icon_src" "$app_dir/Contents/Resources/icon.icns"
  fi

  cat <<EOF > "$app_dir/Contents/Info.plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>run</string>
  <key>CFBundleIconFile</key>
  <string>icon</string>
  <key>CFBundleIdentifier</key>
  <string>com.multigravity.profile.$profile</string>
  <key>CFBundleName</key>
  <string>$app_name</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
</dict>
</plist>
EOF

  print_info "Shortcut created: $app_dir"
}

create_shortcut_linux() {
  # No desktop environment on Termux — skip shortcut creation entirely.
  if is_termux; then
    return 0
  fi

  local profile=$1
  local launcher_root
  local launcher_path
  local desktop_path
  local launcher

  launcher_root="$(linux_launcher_dir)"
  launcher_path="$(linux_launcher_path "$profile")"
  desktop_path="$(linux_desktop_path "$profile")"
  launcher="$(script_path)"

  mkdir -p "$launcher_root"
  mkdir -p "$(dirname "$desktop_path")"

  cat <<EOF > "$launcher_path"
#!/usr/bin/env sh
export MULTIGRAVITY_HOME=$(shell_quote "$BASE")
exec $(shell_quote "$launcher") $(shell_quote "$profile") "\$@"
EOF

  chmod +x "$launcher_path"

  cat <<EOF > "$desktop_path"
[Desktop Entry]
Version=1.0
Type=Application
Name=Multigravity $profile
Comment=Launch the $profile Antigravity profile
Exec=$(desktop_quote "$launcher_path") %F
Icon=antigravity
Terminal=false
StartupNotify=false
StartupWMClass=Antigravity
Categories=TextEditor;Development;IDE;
MimeType=application/x-antigravity-workspace;
EOF

  print_info "Shortcut created: $desktop_path"
}

create_shortcut() {
  case "$(platform)" in
    darwin)
      create_shortcut_darwin "$1"
      ;;
    linux)
      create_shortcut_linux "$1"
      ;;
  esac
}

remove_shortcut() {
  local profile=$1
  local target

  case "$(platform)" in
    darwin)
      target="$(mac_shortcut_path "$profile")"
      if [ -d "$target" ]; then
        rm -rf "$target"
        print_info "Removed shortcut: $target"
      fi
      ;;
    linux)
      # No desktop environment on Termux — nothing to remove.
      if ! is_termux; then
        target="$(linux_launcher_path "$profile")"
        if [ -f "$target" ]; then
          rm -f "$target"
          print_info "Removed shortcut: $target"
        fi

        target="$(linux_desktop_path "$profile")"
        if [ -f "$target" ]; then
          rm -f "$target"
          print_info "Removed shortcut: $target"
        fi
      fi
      ;;
  esac
}

is_cli_app() {
  # Returns 0 (true) when the resolved app is the agy/antigravity CLI binary.
  # The CLI does not accept --user-data-dir / --extensions-dir (IDE-only flags).
  local app_path=$1
  local app_name
  app_name="$(basename "$app_path")"
  case "$app_name" in
    agy | agy.* | antigravity | antigravity-cli)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# Returns the real system home directory, unaffected by profile HOME overrides.
#
# Resolution order:
#   1. MULTIGRAVITY_REAL_HOME — set by the outermost _run_in_profile_env call;
#      preserved across nested profile launches.
#   2. Termux  — derived from $PREFIX (always set by Termux), never hardcoded.
#      e.g. PREFIX=/data/data/com.termux/files/usr  -> home = .../files/home
#   3. Standard Linux/macOS — $HOME as it exists before any profile override.
_real_home() {
  # Already snapshotted by a parent _run_in_profile_env — reuse it.
  if [ -n "${MULTIGRAVITY_REAL_HOME:-}" ]; then
    printf '%s' "$MULTIGRAVITY_REAL_HOME"
    return 0
  fi

  if is_termux && [ -n "${PREFIX:-}" ]; then
    # PREFIX is guaranteed by Termux. Strip the trailing /usr component to get
    # the files/ directory, then append /home.
    printf '%s/home' "${PREFIX%/usr}"
    return 0
  fi

  # Standard Linux or macOS: use the current HOME (not yet overridden at this
  # point since _real_home is always called before HOME= is applied).
  printf '%s' "$HOME"
}

# Check if a profile is shared by path (presence of .shared marker file).
# Complements is_shared_profile() which works by profile name.
_profile_path_is_shared() {
  [ -f "$1/.shared" ]
}

_run_in_profile_env() {
  # Runs "$@" inside the profile's fully isolated environment.
  # Usage: _run_in_profile_env <profile_path> <cmd> [args...]
  #
  # Profile isolation model:
  #
  #   Non-shared profile (default):
  #     Fully isolated — HOME, XDG_*, and all developer tool config dirs
  #     resolve inside the profile directory. Each profile can have its own
  #     gh login, git identity, npm account, etc. Nothing leaks from the
  #     real system home into the profile.
  #
  #   Shared profile (--shared flag / .shared marker):
  #     AGY session/login is still isolated per profile (GEMINI_CLI_HOME,
  #     ANTIGRAVITY_CONFIG_DIR). AGY plugins/extensions/config are symlinked
  #     from the system install (handled by create_shared_layout). Developer
  #     tool credentials (gh, git, npm, go, cargo, ssh, gpg, pip, aws) are
  #     pinned to the real system home so all shared profiles use the same
  #     authenticated tool accounts.
  local profile_path=$1
  shift

  local real_home
  real_home="$(_real_home)"

  # Tool credential passthrough — SHARED PROFILES ONLY on Linux/Termux.
  # Non-shared profiles get full isolation; no passthrough is added.
  # On macOS the Keychain handles credentials independently of HOME regardless.
  local tool_env=()
  if [ "$(platform)" = "linux" ] && _profile_path_is_shared "$profile_path"; then
    # SHARED PROFILE: developer tools must be transparent to the user.
    #
    # Strategy:
    #   a) XDG dirs → real home. Any tool that follows the XDG Base Directory
    #      spec (gh, pip, docker, kubectl, azure-cli, stripe-cli, …) will
    #      automatically find its config/data/cache without being listed here.
    #      New tools installed in future just work with no code changes needed.
    #
    #   b) HOME-based tools (git, ssh, gpg, npm, go, cargo, aws, …) that
    #      hard-code $HOME paths rather than respecting XDG still need explicit
    #      env var overrides because HOME is redirected to the profile dir.
    #
    #   c) AGY session stays isolated via GEMINI_CLI_HOME / ANTIGRAVITY_CONFIG_DIR
    #      (set below, after the tool_env block).
    #
    # Snapshot real home so child processes inherit it.
    tool_env+=(MULTIGRAVITY_REAL_HOME="$real_home")

    # (a) XDG dirs → real home (covers all XDG-compliant tools automatically)
    tool_env+=(XDG_CONFIG_HOME="${XDG_CONFIG_HOME_REAL:-$real_home/.config}")
    tool_env+=(XDG_DATA_HOME="${XDG_DATA_HOME_REAL:-$real_home/.local/share}")
    tool_env+=(XDG_CACHE_HOME="${XDG_CACHE_HOME_REAL:-$real_home/.cache}")
    tool_env+=(XDG_STATE_HOME="${XDG_STATE_HOME_REAL:-$real_home/.local/state}")

    # (b) Explicit overrides for HOME-based (non-XDG) tools
    # Git — uses $HOME/.gitconfig, not XDG
    tool_env+=(GIT_CONFIG_GLOBAL="${GIT_CONFIG_GLOBAL:-$real_home/.gitconfig}")
    tool_env+=(GIT_CONFIG_SYSTEM="${GIT_CONFIG_SYSTEM:-/etc/gitconfig}")
    # SSH — uses $HOME/.ssh
    tool_env+=(SSH_DIR="${SSH_DIR:-$real_home/.ssh}")
    # GPG — uses $HOME/.gnupg
    tool_env+=(GNUPGHOME="${GNUPGHOME:-$real_home/.gnupg}")
    # npm — uses $HOME/.npmrc
    tool_env+=(NPM_CONFIG_USERCONFIG="${NPM_CONFIG_USERCONFIG:-$real_home/.npmrc}")
    # Go — uses $HOME/go and $HOME/.config/go (XDG for env but GOPATH is HOME-based)
    tool_env+=(GOPATH="${GOPATH:-$real_home/go}")
    tool_env+=(GOENV="${GOENV:-$real_home/.config/go/env}")
    # Rust / Cargo — uses $HOME/.cargo
    tool_env+=(CARGO_HOME="${CARGO_HOME:-$real_home/.cargo}")
    # Python / pip user site — uses $HOME/.local
    tool_env+=(PYTHONUSERBASE="${PYTHONUSERBASE:-$real_home/.local}")
    # AWS CLI — uses $HOME/.aws
    tool_env+=(AWS_CONFIG_FILE="${AWS_CONFIG_FILE:-$real_home/.aws/config}")
    tool_env+=(AWS_SHARED_CREDENTIALS_FILE="${AWS_SHARED_CREDENTIALS_FILE:-$real_home/.aws/credentials}")
    # Docker — uses $HOME/.docker (though also respects DOCKER_CONFIG=XDG path)
    tool_env+=(DOCKER_CONFIG="${DOCKER_CONFIG:-$real_home/.docker}")
    # kubectl — uses $HOME/.kube
    tool_env+=(KUBECONFIG="${KUBECONFIG:-$real_home/.kube/config}")

    # Ensure real home's ~/.local/bin is on PATH
    if [[ ":$PATH:" != *":$real_home/.local/bin:"* ]]; then
      tool_env+=(PATH="$real_home/.local/bin:$PATH")
    fi
  fi

  exec env \
  HOME="$profile_path" \
  GEMINI_HOME="$profile_path/.gemini" \
  GEMINI_CLI_HOME="$profile_path/.gemini/antigravity-cli" \
  ANTIGRAVITY_CONFIG_DIR="$profile_path/.gemini/antigravity-cli" \
  XDG_CONFIG_HOME="$profile_path/.config" \
  XDG_CACHE_HOME="$profile_path/.cache" \
  XDG_DATA_HOME="$profile_path/.local/share" \
  XDG_STATE_HOME="$profile_path/.local/state" \
  "${tool_env[@]}" \
  "$@"
}

refresh_profile_token() {
  local prof_dir=$1
  local token_file="$prof_dir/.gemini/antigravity-cli/antigravity-oauth-token"
  [ ! -f "$token_file" ] && token_file="$HOME/.gemini/antigravity-cli/antigravity-oauth-token"

  [ -f "$token_file" ] || return 0

  local access_token refresh_token expiry_str
  access_token=$(grep -o '"access_token"[^,]*' "$token_file" 2>/dev/null | cut -d'"' -f4 || true)
  refresh_token=$(grep -o '"refresh_token"[^,]*' "$token_file" 2>/dev/null | cut -d'"' -f4 || true)
  expiry_str=$(grep -o '"expiry"[^,]*' "$token_file" 2>/dev/null | cut -d'"' -f4 || true)

  [ -z "$refresh_token" ] && return 0

  local is_expired=false
  if [ -n "$expiry_str" ]; then
    local now_sec=$(date +%s)
    local exp_sec=$(date -d "$expiry_str" +%s 2>/dev/null || date -j -f "%Y-%m-%dT%H:%M:%SZ" "$expiry_str" +%s 2>/dev/null || echo 0)
    if [ "$exp_sec" -le "$now_sec" ]; then
      is_expired=true
    fi
  else
    is_expired=true
  fi

  if [ "$is_expired" = true ]; then
    local client_id="1071006060591-tmhssin2h21lcre235vtolojh4g403ep.apps.googleusercontent.com"
    local client_secret="GOCSPX-q_429a3473"
    local refresh_resp
    refresh_resp=$(curl -s -X POST "https://oauth2.googleapis.com/token" \
      --data-urlencode "client_id=$client_id" \
      --data-urlencode "client_secret=$client_secret" \
      --data-urlencode "grant_type=refresh_token" \
      --data-urlencode "refresh_token=$refresh_token" 2>/dev/null || true)

    local new_acc_token
    new_acc_token=$(echo "$refresh_resp" | grep -o '"access_token"[^,]*' | cut -d'"' -f4 || true)
    if [ -n "$new_acc_token" ]; then
      local new_expiry=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || true)
      sed -i "s/\"access_token\":\"[^\"]*\"/\"access_token\":\"$new_acc_token\"/" "$token_file" 2>/dev/null || true
    fi
  fi
}

launch_profile() {
  local profile=$1
  shift || true

  local profile_path app data_dir ext_dir

  profile_path="$(profile_dir "$profile")"
  if [ ! -d "$profile_path" ]; then
    abort "profile '$profile' does not exist. Run: multigravity new $profile"
  fi

  app="$(require_app)"
  data_dir="$(user_data_dir "$profile_path")"
  ext_dir="$(extensions_dir "$profile_path")"

  local type_label="standalone"
  if is_shared_profile "$profile"; then
    type_label="shared"
  fi

  print_info "Switching profile to '$profile' ($type_label)"
  printf "[██░░░░░░░░░░░░░░░░░░] 10%%\r"

  if is_shared_profile "$profile"; then
    create_shared_layout "$profile_path"
  elif [ ! -d "$ext_dir" ]; then
    create_profile_layout "$profile_path"
  fi
  printf "[██████████░░░░░░░░░░] 50%%\r"

  mkdir -p "$profile_path/.gemini/antigravity-cli"
  refresh_profile_token "$profile_path"
  sync 2>/dev/null || true
  printf "[████████████████████] 100%%\n"

  case "$(platform)" in
    darwin)
      _run_in_profile_env "$profile_path" \
        open -n "$app" --args \
        --user-data-dir "$data_dir" \
        --extensions-dir "$ext_dir" \
        "$@"
      ;;
    linux)
      if is_cli_app "$app"; then
        _run_in_profile_env "$profile_path" "$app" "$@"
      else
        _run_in_profile_env "$profile_path" "$app" \
          --user-data-dir "$data_dir" \
          --extensions-dir "$ext_dir" \
          "$@"
      fi
      ;;
  esac
}

list_profiles() {
  local raw=${1-}

  if [ ! -d "$BASE" ]; then
    if [ "$raw" != "--raw" ]; then
      print_info "No profiles found."
    fi
    return 0
  fi

  if [ "$raw" = "--raw" ]; then
    local entries="" dir
    for dir in "$BASE"/*; do
      [ -d "$dir" ] || continue
      local n="$(basename "$dir")"
      [ "$n" = ".templates" ] && continue
      entries="${entries}${n}"$'\n'
    done
    if [ -n "$entries" ]; then
      printf '%s' "$entries" | sort
    fi
    return 0
  fi

  printf "%-12s %-8s %-8s %s\n" "PROFILE" "TYPE" "SIZE" "LAST USED"
  printf "%-12s %-8s %-8s %s\n" "-------" "----" "----" "---------"

  local dir
  for dir in "$BASE"/*; do
    [ -d "$dir" ] || continue
    local name="$(basename "$dir")"
    [ "$name" = ".templates" ] && continue

    local ptype="full"
    is_shared_profile "$name" && ptype="shared"

    local size
    size="$(du -sh "$dir" 2>/dev/null | cut -f1)"

    local last_used
    case "$(platform)" in
      darwin) last_used=$(stat -f "%Sm" -t "%Y-%m-%d %H:%M" "$dir" 2>/dev/null || echo "never") ;;
      linux)  last_used=$(stat -c "%y" "$dir" 2>/dev/null | cut -d':' -f1-2 || echo "never") ;;
    esac

    printf "%-12s %-8s %-8s %s\n" "$name" "$ptype" "$size" "$last_used"
  done

  echo ""
  local total_size
  total_size="$(du -sh "$BASE" 2>/dev/null | cut -f1)"
  print_info "Total usage: $total_size"
}

new_profile() {
  local profile="" shared=false share_history=true from_tpl=""

  if [ $# -eq 0 ]; then
    new_profile_wizard
    return 0
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --shared)            shared=true ;;
      --no-share-history)  share_history=false ;;
      --from)              from_tpl="${2-}"; shift ;;
      -*)                  abort "unknown option: $1" ;;
      *)                   profile="$1" ;;
    esac
    shift
  done

  validate_name "$profile"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  if [ -d "$profile_path" ]; then
    abort "profile '$profile' already exists"
  fi

  export SHARE_HISTORY="$share_history"

  mkdir -p "$BASE"

  if [ "$from_tpl" = "default" ]; then
    if [ "$shared" = true ]; then
      create_shared_layout "$profile_path"
    else
      create_profile_layout "$profile_path"
    fi
    local copied=false
    if [ -d "$HOME/.gemini/antigravity-cli" ]; then
      mkdir -p "$profile_path/.gemini"
      cp -R "$HOME/.gemini/antigravity-cli" "$profile_path/.gemini/" 2>/dev/null || true
      copied=true
    fi
    if [ -d "$HOME/.gemini/config" ] && [ "$shared" = false ]; then
      mkdir -p "$profile_path/.gemini"
      cp -R "$HOME/.gemini/config" "$profile_path/.gemini/" 2>/dev/null || true
      copied=true
    fi
    if [ -d "$HOME/.config/Antigravity" ]; then
      mkdir -p "$profile_path/.config"
      cp -R "$HOME/.config/Antigravity" "$profile_path/.config/" 2>/dev/null || true
      copied=true
    fi
    if [ "$copied" = true ]; then
      print_info "Seeded profile '$profile' from default Antigravity session data..."
    else
      print_info "Default session data not found. Initialized clean profile '$profile'."
    fi
  elif [ -n "$from_tpl" ]; then
    local tpl_path
    # Validate template name to prevent path traversal (e.g. --from ../otherprofile)
    validate_name "$from_tpl"
    tpl_path="$(templates_dir)/$from_tpl"
    [ -d "$tpl_path" ] || abort "template '$from_tpl' not found. Run: multigravity template list"
    print_info "Creating profile '$profile' from template '$from_tpl'..."
    cp -R "$tpl_path" "$profile_path"
  elif [ "$shared" = true ]; then
    create_shared_layout "$profile_path"
  else
    create_profile_layout "$profile_path"
  fi

  print_info "Created profile '$profile'"
  create_shortcut "$profile"
}

delete_profile() {
  local profile=$1
  local profile_path
  local confirm

  validate_name "$profile"

  profile_path="$(profile_dir "$profile")"
  if [ ! -d "$profile_path" ]; then
    abort "profile '$profile' does not exist"
  fi

  read -r -p "Delete profile '$profile' and all its data? [y/N] " confirm
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    rm -rf "$profile_path"
    remove_shortcut "$profile"
    print_info "Deleted profile '$profile'"
  else
    print_info "Aborted."
  fi
}

rename_profile() {
  local old=$1
  local new=$2
  local old_path
  local new_path

  validate_name "$old"
  validate_name "$new"

  old_path="$(profile_dir "$old")"
  new_path="$(profile_dir "$new")"

  if [ ! -d "$old_path" ]; then
    abort "profile '$old' does not exist"
  fi
  if [ -d "$new_path" ]; then
    abort "profile '$new' already exists"
  fi

  mv "$old_path" "$new_path"
  remove_shortcut "$old"
  create_shortcut "$new"

  print_info "Renamed profile '$old' to '$new'"
}

clone_profile() {
  local src=$1
  local dest=$2
  local src_path
  local dest_path

  validate_name "$src"
  validate_name "$dest"

  src_path="$(profile_dir "$src")"
  dest_path="$(profile_dir "$dest")"

  if [ ! -d "$src_path" ]; then
    abort "source profile '$src' does not exist"
  fi
  if [ -d "$dest_path" ]; then
    abort "destination profile '$dest' already exists"
  fi

  print_info "Cloning profile '$src' to '$dest'..."
  cp -R "$src_path" "$dest_path"
  create_shortcut "$dest"

  print_info "Successfully cloned '$src' to '$dest'"
}

doctor_cli() {
  local errors=0
  local warnings=0

  print_info "Checking multigravity environment..."

  # 1. Platform Check
  if platform &>/dev/null; then
    if is_termux; then
      echo "  [✓] Platform: $(platform) (Termux)"
    else
      echo "  [✓] Platform: $(platform)"
    fi
  else
    echo "  [✗] Platform: Unknown"
    errors=$((errors + 1))
  fi

  # 2. Antigravity Installation
  if app=$(find_app); then
    echo "  [✓] Antigravity: Found at $app"
  else
    echo "  [✗] Antigravity: Not found. Ensure it is installed or set MULTIGRAVITY_APP."
    errors=$((errors + 1))
  fi

  # 3. Path Check
  local installed
  installed="$(command -v mgy 2>/dev/null || command -v multigravity 2>/dev/null || true)"
  if [ -n "$installed" ]; then
    echo "  [✓] Global Binary: $installed"
  else
    echo "  [!] Global Binary: Not found in PATH. Run install script or update PATH."
    warnings=$((warnings + 1))
  fi

  # 4. Icon Check (macOS)
  if [ "$(platform)" = "darwin" ]; then
    local icon_path
    icon_path="$(dirname "$(script_path)")/icon.icns"
    if [ -f "$icon_path" ]; then
      echo "  [✓] Application Icon: Found"
    else
      echo "  [!] Application Icon: Missing ($icon_path). Shortcuts will have default icons."
      warnings=$((warnings + 1))
    fi
  fi

  # 5. Base Directory
  if [ -d "$BASE" ]; then
    if [ -w "$BASE" ]; then
      echo "  [✓] Profile storage: $BASE (writable)"
    else
      echo "  [✗] Profile storage: $BASE (NOT writable)"
      errors=$((errors + 1))
    fi
  else
    echo "  [!] Profile storage: $BASE (Not yet created)"
  fi

  echo ""
  if [ $errors -eq 0 ]; then
    if [ $warnings -eq 0 ]; then
      print_info "✓ Your environment looks perfect!"
    else
      print_info "Found $warnings warning(s). Multigravity should still work, but some features might be degraded."
    fi
  else
    print_info "✗ Found $errors error(s) and $warnings warning(s). Please fix the errors above."
  fi
}

new_profile_wizard() {
  echo "=================================================="
  echo "  Multigravity Profile Creation Wizard"
  echo "=================================================="
  echo ""

  local p_name=""
  while true; do
    read -r -p "  Enter new profile name: " p_name
    if [ -z "$p_name" ]; then
      echo "  Error: Profile name cannot be empty."
    elif ! validate_name "$p_name" 2>/dev/null; then
      echo "  Error: Invalid profile name. Use alphanumeric characters, hyphens, or underscores."
    elif [ -d "$(profile_dir "$p_name")" ]; then
      echo "  Error: Profile '$p_name' already exists."
    else
      break
    fi
  done
  echo ""

  print_info "Profile Type:"
  echo "  1) Isolated (Independent extensions, settings & session data)"
  echo "  2) Shared (Shares global extensions & settings across profiles)"
  read -r -p "  Select profile type [1/2, default: 1]: " p_type_choice
  local is_shared=false
  if [ "$p_type_choice" = "2" ]; then
    is_shared=true
  fi
  echo ""

  print_info "Seed Profile Data From:"
  echo "  1) Clean / Empty starting state"
  echo "  2) Default logged-in Antigravity session"
  echo "  3) A saved template"
  read -r -p "  Select seed source [1/2/3, default: 1]: " seed_choice

  local extra_args=()
  if [ "$is_shared" = true ]; then
    extra_args+=("--shared")
  fi

  case "$seed_choice" in
    2)
      extra_args+=("--from" "default")
      ;;
    3)
      local tpls
      tpls="$(list_templates_raw 2>/dev/null || true)"
      if [ -z "$tpls" ]; then
        echo "  No saved templates found. Initializing clean profile."
      else
        echo "  Available templates:"
        for t in $tpls; do
          echo "    - $t"
        done
        read -r -p "  Enter template name: " selected_tpl
        if [ -n "$selected_tpl" ]; then
          extra_args+=("--from" "$selected_tpl")
        fi
      fi
      ;;
  esac
  echo ""

  new_profile "$p_name" "${extra_args[@]}"
}

profile_stats() {
  if [ ! -d "$BASE" ]; then
    print_info "No profiles found."
    return 0
  fi

  print_info "Profile Storage Usage:"
  printf "%-20s %-10s %-10s\n" "PROFILE" "SIZE" "EXTENSIONS"
  printf "%-20s %-10s %-10s\n" "-------" "----" "----------"

  local dir
  for dir in "$BASE"/*; do
    [ -d "$dir" ] || continue
    local name
    name=$(basename "$dir")
    [ "$name" = ".templates" ] && continue

    local size
    size=$(du -sh "$dir" | cut -f1)

    local ext_count
    ext_count=$(ls -1 "$(extensions_dir "$dir")" 2>/dev/null | wc -l | xargs)
    [ -z "$ext_count" ] && ext_count=0

    printf "%-20s %-10s %-10s\n" "$name" "$size" "$ext_count"
  done

  echo ""
  local total
  total=$(du -sh "$BASE" | cut -f1)
  print_info "Total usage: $total"
}

status_profiles() {
  if [ ! -d "$BASE" ]; then
    print_info "No profiles found."
    return 0
  fi

  printf "%-18s %-10s %-12s %-20s %s\n" "PROFILE" "RUNNING" "TYPE" "LAST USED" "SIZE"
  printf "%-18s %-10s %-12s %-20s %s\n" "-------" "-------" "----" "---------" "----"

  local dir
  for dir in "$BASE"/*; do
    [ -d "$dir" ] || continue
    local name
    name="$(basename "$dir")"
    [ "$name" = ".templates" ] && continue

    local running="no"
    local data_dir
    data_dir="$(user_data_dir "$dir")"
    if ps -eo args 2>/dev/null | grep -v grep | grep -qF "$data_dir"; then
      running="yes"
    fi

    local ptype="full"
    is_shared_profile "$name" && ptype="shared"

    local last_used
    case "$(platform)" in
      darwin) last_used=$(stat -f "%Sm" -t "%Y-%m-%d %H:%M" "$dir" 2>/dev/null || echo "unknown") ;;
      linux)  last_used=$(stat -c "%y" "$dir" 2>/dev/null | cut -d'.' -f1 || echo "unknown") ;;
    esac

    local size
    size="$(du -sh "$dir" 2>/dev/null | cut -f1)"

    if [ "$running" = "yes" ]; then
      printf "%-18s \033[32m%-10s\033[0m %-12s %-20s %s\n" "$name" "$running" "$ptype" "$last_used" "$size"
    else
      printf "%-18s %-10s %-12s %-20s %s\n" "$name" "$running" "$ptype" "$last_used" "$size"
    fi
  done
}

template_cmd() {
  local subcmd="${1-}"
  shift || true

  case "$subcmd" in
    save)
      local profile="${1-}" tpl_name="${2-}"
      validate_name "$profile"
      validate_name "$tpl_name"
      local src_path tpl_dir tpl_path
      src_path="$(profile_dir "$profile")"
      [ -d "$src_path" ] || abort "profile '$profile' does not exist"
      tpl_dir="$(templates_dir)"
      tpl_path="$tpl_dir/$tpl_name"
      [ -d "$tpl_path" ] && abort "template '$tpl_name' already exists"
      mkdir -p "$tpl_dir"
      print_info "Saving '$profile' as template '$tpl_name'..."
      cp -R "$src_path" "$tpl_path"
      rm -f "$tpl_path/.shared"
      print_info "Saved template '$tpl_name'"
      ;;
    list)
      local tpl_dir
      tpl_dir="$(templates_dir)"
      echo "Templates:"
      if [ ! -d "$tpl_dir" ]; then
        echo "  (none)"
        return 0
      fi
      local any=false
      for d in "$tpl_dir"/*; do
        [ -d "$d" ] || continue
        any=true
        printf "  %-20s %s\n" "$(basename "$d")" "$(du -sh "$d" 2>/dev/null | cut -f1)"
      done
      [ "$any" = false ] && echo "  (none)"
      ;;
    delete)
      local tpl_name="${1-}"
      validate_name "$tpl_name"
      local tpl_path
      tpl_path="$(templates_dir)/$tpl_name"
      [ -d "$tpl_path" ] || abort "template '$tpl_name' does not exist"
      rm -rf "$tpl_path"
      print_info "Deleted template '$tpl_name'"
      ;;
    *)
      abort "usage: multigravity template <save|list|delete>"
      ;;
  esac
}

sync_profile() {
  local subcommand="${1-}"
  shift || true

  case "$subcommand" in
    export)
      local profile="${1-}" out="${2-}"
      validate_name "$profile"
      local profile_path="$(profile_dir "$profile")"
      [ -d "$profile_path" ] || abort "profile '$profile' does not exist"
      [ -z "$out" ] && out="./${profile}-history.tar.gz"

      local brain_dir="$profile_path/.gemini/antigravity-cli/brain"
      [ -d "$brain_dir" ] || abort "profile '$profile' has no history directory"

      print_info "Exporting history from '$profile' to $out ..."
      tar -czf "$out" -C "$(dirname "$brain_dir")" "brain"
      print_info "Done."
      ;;
    import)
      local archive="${1-}" profile="${2-}"
      [ -n "$archive" ] || abort "usage: multigravity sync import <archive.tar.gz> <profile>"
      [ -f "$archive" ] || abort "archive file not found: $archive"
      validate_name "$profile"
      local profile_path="$(profile_dir "$profile")"
      [ -d "$profile_path" ] || abort "target profile '$profile' does not exist"

      local target_brain="$profile_path/.gemini/antigravity-cli/brain"
      mkdir -p "$(dirname "$target_brain")"
      print_info "Importing history from $archive into '$profile' ..."
      tar -xzf "$archive" -C "$(dirname "$target_brain")"
      print_info "Done."
      ;;
    *)
      local src="$subcommand" tgt="${1-}"
      [ -n "$src" ] && [ -n "$tgt" ] || abort "usage: multigravity sync <source_profile> <target_profile> OR multigravity sync <export|import>"
      validate_name "$src"
      validate_name "$tgt"

      local src_path="$(profile_dir "$src")"
      local tgt_path="$(profile_dir "$tgt")"
      [ -d "$src_path" ] || abort "source profile '$src' does not exist"
      [ -d "$tgt_path" ] || abort "target profile '$tgt' does not exist"

      local src_brain="$src_path/.gemini/antigravity-cli/brain"
      local tgt_brain="$tgt_path/.gemini/antigravity-cli/brain"

      [ -d "$src_brain" ] || abort "source profile '$src' has no conversation history to sync"

      print_info "Syncing history from '$src' to '$tgt' (excluding credentials) ..."
      mkdir -p "$tgt_brain"
      cp -rn "$src_brain"/* "$tgt_brain/" 2>/dev/null || true
      print_info "Done."
      ;;
  esac
}

export_profile() {
  local profile="${1-}" out="${2-}"
  validate_name "$profile"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  [ -d "$profile_path" ] || abort "profile '$profile' does not exist"

  [ -z "$out" ] && out="./${profile}.tar.gz"

  print_info "Exporting '$profile' to $out ..."
  tar -czf "$out" -C "$BASE" "$profile"
  print_info "Done."
}

import_profile() {
  local archive="${1-}" profile="${2-}"

  [ -n "$archive" ] || abort "usage: multigravity import <archive.tar.gz> [name]"
  [ -f "$archive" ]  || abort "file not found: $archive"

  # Read archive top-level directory once and reuse (avoids two separate tar reads)
  local top_dir
  top_dir="$(tar -tzf "$archive" 2>/dev/null | head -1 | cut -d'/' -f1)"

  if [ -z "$profile" ]; then
    profile="$top_dir"
    [ -n "$profile" ] || abort "cannot infer profile name from archive — pass a name explicitly"
  fi

  validate_name "$profile"

  local dest
  dest="$(profile_dir "$profile")"
  [ -d "$dest" ] && abort "profile '$profile' already exists — choose a different name or delete it first"

  mkdir -p "$BASE"
  print_info "Importing as '$profile'..."

  tar -xzf "$archive" -C "$BASE"
  if [ -n "$top_dir" ] && [ "$top_dir" != "$profile" ] && [ -d "$BASE/$top_dir" ]; then
    mv "$BASE/$top_dir" "$dest"
  fi

  create_shortcut "$profile"
  print_info "Imported profile '$profile'"
}

update_cli() {
  local script_url="https://raw.githubusercontent.com/sujitagarwal/multigravity-cli/main/multigravity"
  local target
  target="$(script_path)"

  if [ -z "$target" ]; then
    abort "could not determine script path for update"
  fi

  print_info "Updating multigravity from $script_url ..."
  if curl -fsSL "$script_url" -o "$target.tmp"; then
    # Integrity check: verify the download looks like a valid shell script before replacing.
    if ! head -1 "$target.tmp" 2>/dev/null | grep -qE '^#!.*(env +[a-z]*sh|bash|sh)'; then
      rm -f "$target.tmp"
      abort "downloaded file does not appear to be a valid shell script — update aborted to prevent corruption"
    fi
    # On Termux, env is not at /usr/bin — patch the shebang to use the Termux path.
    if is_termux; then
      sed -i '1s|^#!/usr/bin/env|#!/data/data/com.termux/files/usr/bin/env|' "$target.tmp"
    fi
    mv "$target.tmp" "$target"
    chmod +x "$target"
    print_info "Successfully updated multigravity!"
  else
    rm -f "$target.tmp"
    abort "failed to download update"
  fi
}

install_completion() {
  local target_rc="$HOME/.bashrc"
  if [ -n "${SHELL:-}" ] && [[ "$SHELL" == *"zsh"* ]]; then
    target_rc="$HOME/.zshrc"
  fi
  touch "$target_rc"
  if grep -q "mgy completion" "$target_rc" 2>/dev/null; then
    echo "  ✓ Autocompletion is already active in $target_rc"
  else
    echo '' >> "$target_rc"
    echo '# Multigravity CLI shell autocompletion' >> "$target_rc"
    echo 'source <(mgy completion bash 2>/dev/null || multigravity completion bash)' >> "$target_rc"
    echo "  ✓ Autocompletion added to $target_rc"
    echo "  Run 'source $target_rc' or restart terminal to activate."
  fi
}

help_completion() {
  local shell_name
  shell_name="$(basename "$SHELL")"

  echo "To enable autocompletion, add the following to your shell profile:"
